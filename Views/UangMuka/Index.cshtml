@using System.Security.Claims
@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    string? currentUserId = User?.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    string? userRole = User?.FindFirstValue(ClaimTypes.Role) ?? string.Empty;
    bool isAdmin = userRole == "SUPER_ADMIN" || userRole == "ADMIN";
}

@section Styles {
    <!-- Select2 CSS for searchable dropdowns -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css"
          rel="stylesheet" />
    <style>
        div.dataTables_wrapper div.dataTables_filter label,
        div.dataTables_wrapper div.dataTables_length label {
            margin-bottom: 0;
        }

        div.dataTables_wrapper div.dataTables_filter input {
            width: 240px;
        }

        table.dataTable>thead>tr>th {
            white-space: nowrap;
        }

        .dataTables_scrollBody {
            padding-bottom: .5rem;
        }

        td.dt-actions {
            padding-top: .6rem !important;
            padding-bottom: .6rem !important;
            overflow: visible !important;
        }

        .pc-container,
        .pcoded-main-container,
        .pc-content,
        .main-body,
        .page-wrapper {
            transform: none !important;
            filter: none !important;
            perspective: none !important;
            will-change: auto !important;
        }

        .bg-primary-soft {
            background-color: rgba(13, 110, 253, 0.1);
        }
    </style>
}

<input type="hidden" id="currentUserId" value="@currentUserId" />
<input type="hidden" id="currentUserIsAdmin" value="@isAdmin.ToString().ToLower()" />

<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Advanced, Biaya & Realisasi Uang Muka</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)">Transactions</a></li>
            <li class="breadcrumb-item">Advance, Biaya & Realisasi Uang Muka</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex align-items-center gap-2 page-header-right-items-wrapper">
                <button id="btnCreateContract" type="button" class="btn btn-primary">
                    <i class="feather-plus me-2"></i>
                    <span>Add New Data</span>
                </button>
            </div>
        </div>
    </div>
</div>
<!-- [ page-header ] end -->

<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <h6 class="mb-0">Data List</h6>
                            <small class="text-muted">Manage Advanced, Biaya & Realisasi Uang Muka</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="unagMukasTable"
                               class="table table-striped table-bordered table-hover align-middle w-100">
                            <thead>
                                <tr>
                                    <th>Atas Nama</th>
                                    <th>Jenis</th>
                                    <th>Amount</th>
                                    <th>Budget Code</th>
                                    <th>COA Text</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->

<!-- Detail Modal Uang Muka -->
<div class="modal fade" id="uangMukaDetailModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="uangMukaDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uangMukaDetailModalLabel">Detail Uang Muka</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="uangMukaDetailContent">
                    <!-- Dynamic content loaded by JS -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal Uang Muka -->
<div class="modal fade" id="uangMukaModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="uangMukaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <form id="uangMukaForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="uangMukaModalLabel">Create/Edit Uang Muka</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="uangMukaId" />
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Jenis</label>
                            <select id="jenis" class="form-control" required>
                                <option value="">-- Pilih Jenis --</option>
                                <option value="Advanced">Advanced</option>
                                <option value="Biaya">Biaya</option>
                                <option value="Realisasi">Realisasi</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Budget Code <span id="budgetCodeOptional" class="text-muted small"
                                                                            style="display:none;">(Optional)</span></label>
                                <select id="budgetCodeId" class="form-control"></select>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">COA Text <span id="coaTextOptional" class="text-muted small"
                                                                             style="display:none;">(Optional)</span></label>
                                    <select id="coaTextId" class="form-control"></select>
                                </div>
                                <div class="col-md-12" id="UangMukaRelatedIdWrapper" style="display:none;">
                                    <label class="form-label">Advanced yang di realisasikan (Optional)</label>
                                    <select id="UangMukaRelatedId" class="form-control"></select>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Atas Nama</label>
                                    <input id="atasNama" class="form-control" required />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Amount</label>
                                    <input id="amount" type="number" class="form-control" required min="0" step="0.01" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Start Date</label>
                                    <input id="startDate" type="date" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">End Date</label>
                                    <input id="endDate" type="date" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Status</label>
                                    <select id="statusId" class="form-control" required></select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">No SAP</label>
                                    <input id="noSAP" class="form-control" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Deskripsi</label>
                                    <textarea id="deskripsi" class="form-control" rows="2"></textarea>
                                </div>
                                <!-- Attachments Section (only for Edit mode) -->
                                <div id="attachmentsSection" class="mt-4">
                                    <hr />
                                    <h6 class="mb-3">Attachments</h6>
                                    <div class="mb-3">
                                        <label class="form-label">Upload File</label>
                                        <input type="file" id="fileUpload" class="form-control"
                                               accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
                                        <small class="text-muted">Max 10MB. Allowed: PDF, Images, Word, Excel</small>
                                    </div>
                                    <div id="attachmentsList" class="list-group"></div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @section Scripts {
            <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
            <script src="/js/transaction-uang-muka.js?v=@DateTime.Now.Ticks"></script>
            <script src="/js/transaction-uang-muka-attachment.js?v=@DateTime.Now.Ticks"></script>
            <script src="/js/transaction-uang-muka-detail.js?v=@DateTime.Now.Ticks"></script>
            <script>
                $(function () {
                function toggleOptionalLabel() {
                var jenis = $('#jenis').val();
                if (jenis === 'Advanced') {
                $('#budgetCodeOptional').show();
                $('#coaTextOptional').show();
                } else {
                $('#budgetCodeOptional').hide();
                $('#coaTextOptional').hide();
                }
                }
                $('#jenis').on('change', toggleOptionalLabel);
                // Trigger saat modal dibuka (untuk edit)
                $('#uangMukaModal').on('shown.bs.modal', toggleOptionalLabel);
                });
            </script>
        }
