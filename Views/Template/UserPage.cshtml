@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container py-4">
    <h3 class="mb-4 fw-bold text-center">Template Dokumen User</h3>
    <div class="row" id="userTemplateList">
        <!-- Card template akan di-render oleh JS -->
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        .template-card {
            transition: box-shadow .2s, transform .2s;
            border-radius: 1rem;
        }

        .template-card:hover {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, .08) !important;
            transform: translateY(-4px) scale(1.03);
        }

        .file-icon {
            width: 5.5rem;
            height: 5.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8f9fa;
            border-radius: 1rem;
        }
    </style>
}

@section Scripts {
    <script src="/js/user-template.js?v=@DateTime.Now.Ticks"></script>
}

