@using System.Security.Claims
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    string? currentUserId = User?.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    string? userName = User?.FindFirstValue(ClaimTypes.Name) ?? "User";
}

<div class="main-content">
    <div class="row">
        <!-- Welcome Banner -->
        <div class="col-12">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h4 class="text-white mb-2">Welcome back, @userName! 👋</h4>
                    <p class="text-white-50 mb-0">Here's your vendor performance overview</p>
                </div>
            </div>
        </div>

        <!-- [My Invoice Stats] start -->
        <div class="col-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">My Invoice Statistics</h5>
                    <div class="card-header-action">
                        <div class="card-header-btn">
                            <div data-bs-toggle="tooltip" title="Refresh">
                                <a href="javascript:void(0);" class="avatar-text avatar-xs bg-warning"
                                   onclick="loadUserStats()"> </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">Total Invoices</div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="fw-bold text-primary mb-0" id="userTotalInvoices">0</h3>
                                    <span
                                        class="badge bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px;">
                                        <i class="feather-file-text fs-5"></i>
                                    </span>
                                </div>
                                <div class="fs-11 text-muted mt-1">All submitted</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">On-Time Submissions</div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="fw-bold text-success mb-0" id="userOnTimeCount">0</h3>
                                    <span
                                        class="badge bg-success-subtle text-success d-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px;">
                                        <i class="feather-check-circle fs-5"></i>
                                    </span>
                                </div>
                                <div class="fs-11 text-muted mt-1">Submitted by 7th</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">Late Submissions</div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="fw-bold text-danger mb-0" id="userLateCount">0</h3>
                                    <span
                                        class="badge bg-danger-subtle text-danger d-flex align-items-center justify-content-center"
                                        style="width: 32px; height: 32px;">
                                        <i class="feather-alert-circle fs-5"></i>
                                    </span>
                                </div>
                                <div class="fs-11 text-muted mt-1">After deadline</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded position-relative">
                                <div class="fs-12 text-muted mb-1">On-Time Performance</div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="fw-bold mb-0" id="userOnTimePercentage">0%</h3>
                                    <span id="userStatusBadge"
                                          class="badge d-flex align-items-center justify-content-center"
                                          style="width: 70px; height: 32px;"></span>
                                </div>
                                <div class="progress mt-2" style="height: 10px;">
                                    <div id="userProgressBar" class="progress-bar" role="progressbar" style="width: 0%">
                                    </div>
                                </div>
                                <div class="fs-11 text-muted mt-1">Target: ≤ 7th of month</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [My Invoice Stats] end -->


        <!-- [Performance Chart & Recent Activity] start -->
        <div class="col-xxl-6">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">My Submission Performance</h5>
                    <div class="card-header-action">
                        <select id="userYearFilter" class="form-select form-select-sm" style="width: 120px;">
                            <option value="">All Years</option>
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026" selected>2026</option>
                            <option value="2027">2027</option>
                        </select>
                    </div>
                </div>
                <div class="card-body custom-card-action">
                    <div id="user-performance-chart"></div>
                </div>
            </div>
        </div>

        <div class="col-xxl-6">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Monthly Submission Trend</h5>
                    <div class="card-header-action">
                        <div class="card-header-btn">
                            <div data-bs-toggle="tooltip" title="Refresh">
                                <a href="javascript:void(0);" class="avatar-text avatar-xs bg-warning"
                                   onclick="loadUserMonthlyTrend()"> </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body custom-card-action">
                    <div id="user-monthly-trend-chart"></div>
                </div>
            </div>
        </div>
        <!-- [Performance Chart & Recent Activity] end -->

        <!-- [Recent Invoices] start -->
        <div class="col-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Recent Invoices</h5>
                    <div class="card-header-action">
                        <a href="/Invoice" class="btn btn-sm btn-light-brand">View All</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Invoice Number</th>
                                    <th>Amount</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center">On-Time</th>
                                    <th>Submitted Date</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="recentInvoicesTable">
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">Loading...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- [Recent Invoices] end -->

        <!-- [Performance Tips] start -->
        <div class="col-12">
            <div class="card stretch stretch-full border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <div
                            class="avatar avatar-lg bg-soft-primary text-primary d-flex align-items-center justify-content-center rounded-circle">
                            <i class="feather-info fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-2">Performance Tips 💡</h6>
                            <ul class="mb-0">
                                <li class="mb-1"><strong>Submit invoices by the 7th</strong> of each month to maintain
                                    "On-Time" status</li>
                                    <li class="mb-1"><strong>Target 90%+ on-time rate</strong> for "Excellent" performance
                                        rating</li>
                                        <li class="mb-1"><strong>Complete all required fields</strong> to avoid delays in
                                            processing</li>
                                            <li><strong>Check status regularly</strong> for admin updates and approvals</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- [Performance Tips] end -->
                </div>
            </div>

            @section Scripts {
                <script src="~/js/dashboard-user.js?v=@DateTime.Now.Ticks"></script>
            }