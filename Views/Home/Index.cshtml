@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="main-content">
    <div class="row">
        <!-- [Contract & Invoice Stats] start -->
        <div class="col-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Contract & Invoice Overview</h5>
                    <div class="card-header-action">
                        <div class="card-header-btn">
                            <div data-bs-toggle="tooltip" title="Refresh">
                                <a href="javascript:void(0);" class="avatar-text avatar-xs bg-warning"
                                   onclick="loadDashboardStats()"> </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">Active Contracts</div>
                                <div class="d-flex align-items-center gap-2">
                                    <h3 class="fw-bold text-success mb-0" id="activeContractsCount">0</h3>
                                    <span class="badge bg-success-subtle text-success">
                                        <i class="feather-check-circle"></i>
                                    </span>
                                </div>
                                <div class="fs-11 text-muted mt-1">Currently active</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">Expiring Soon</div>
                                <div class="d-flex align-items-center gap-2">
                                    <h3 class="fw-bold text-warning mb-0" id="contractsExpiringSoon">0</h3>
                                    <span class="badge bg-warning-subtle text-warning">
                                        <i class="feather-alert-circle"></i>
                                    </span>
                                </div>
                                <div class="fs-11 text-muted mt-1">Next 30 days</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">Total Invoices</div>
                                <div class="d-flex align-items-center gap-2">
                                    <h3 class="fw-bold text-primary mb-0" id="totalInvoicesSubmitted">0</h3>
                                    <span class="badge bg-primary-subtle text-primary">
                                        <i class="feather-file-text"></i>
                                    </span>
                                </div>
                                <div class="fs-11 text-muted mt-1">All submitted</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">Total Invoice Amount</div>
                                <div class="d-flex align-items-center gap-2">
                                    <h3 class="fw-bold text-info mb-0" id="totalInvoiceAmount">Rp 0</h3>
                                    <span class="badge bg-info-subtle text-info">
                                        <i class="feather-dollar-sign"></i>
                                    </span>
                                </div>
                                <div class="fs-11 text-muted mt-1">Cumulative value</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [Contract & Invoice Stats] end -->

        <!-- [Invoice Summary Total by Status ] -->
        <div class="col-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Invoice Overview by Status</h5>
                    <div class="card-header-action">
                        <div class="card-header-btn">
                            <div data-bs-toggle="tooltip" title="Refresh">
                                <a href="javascript:void(0);" class="avatar-text avatar-xs bg-warning"
                                   onclick="loadDashboardStats()"> </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div id="invoice_by_status_area"></div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [Invoice Summary Total by Status ] end -->

        <!-- [Uang Muka Dashboard Tabs] start -->
        <div class="col-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Uang Muka Overview by Status</h5>
                    <ul class="nav nav-tabs card-header-tabs" id="uangMukaTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-advanced" data-bs-toggle="tab"
                                    data-bs-target="#uangmuka-advanced-area" type="button" role="tab"
                                    aria-controls="uangmuka-advanced-area" aria-selected="true">Advanced</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-biaya" data-bs-toggle="tab"
                                    data-bs-target="#uangmuka-biaya-area" type="button" role="tab"
                                    aria-controls="uangmuka-biaya-area" aria-selected="false">Biaya</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-realisasi" data-bs-toggle="tab"
                                    data-bs-target="#uangmuka-realisasi-area" type="button" role="tab"
                                    aria-controls="uangmuka-realisasi-area" aria-selected="false">Realisasi</button>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content" id="uangMukaTabsContent">
                        <div class="tab-pane fade show active" id="uangmuka-advanced-area" role="tabpanel"
                             aria-labelledby="tab-advanced">
                            <div class="row">
                                <div id="uangmuka_by_status_area_advanced"></div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="uangmuka-biaya-area" role="tabpanel" aria-labelledby="tab-biaya">
                            <div class="row">
                                <div id="uangmuka_by_status_area_biaya"></div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="uangmuka-realisasi-area" role="tabpanel"
                             aria-labelledby="tab-realisasi">
                            <div class="row">
                                <div id="uangmuka_by_status_area_realisasi"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [Uang Muka Dashboard Tabs] end -->

        <!-- Modal moved to bottom for correct stacking -->
    </div> <!-- end .main-content or main container -->

    <!-- Modal Detail Uang Muka (moved outside grid for Bootstrap stacking fix) -->
    <div class="modal fade" id="uangMukaDetailModal" tabindex="-1" aria-labelledby="uangMukaDetailModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="uangMukaDetailModalLabel">Detail Uang Muka</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="uangMukaDetailContent">
                        <!-- Detail content will be loaded here -->
                    </div>
                </div>
                <div class="modal-footer">
                    <!-- Export to Excel button removed, now handled by DataTables -->
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-- End of Modal Detail Uang Muka -->

    <!-- [Vendor On-Time Submission KPI] start -->
    <div class="col-12">
        <div class="card stretch stretch-full">
            <div class="card-header">
                <h5 class="card-title">Vendor On-Time Submission KPI <span class="badge bg-info">Target: ≤ 7th
                    Day</span></h5>
                    <div class="card-header-action">
                        <select id="ontimeYearFilter" class="form-select form-select-sm" style="width: 120px;">
                            <option value="">All Years</option>
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026" selected>2026</option>
                            <option value="2027">2027</option>
                        </select>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Overall Stats -->
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">Total Invoices</div>
                                <h3 class="fw-bold text-dark" id="ontimeTotalInvoices">0</h3>
                                <div class="fs-11 text-muted mt-1">All submissions</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">On-Time Submissions</div>
                                <div class="d-flex align-items-center gap-2">
                                    <h3 class="fw-bold text-success mb-0" id="ontimeOnTimeCount">0</h3>
                                    <span class="badge bg-success-subtle text-success">
                                        <i class="feather-check-circle"></i>
                                    </span>
                                </div>
                                <div class="fs-11 text-muted mt-1">Submitted by 7th</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded">
                                <div class="fs-12 text-muted mb-1">Late Submissions</div>
                                <div class="d-flex align-items-center gap-2">
                                    <h3 class="fw-bold text-danger mb-0" id="ontimeLateCount">0</h3>
                                    <span class="badge bg-danger-subtle text-danger">
                                        <i class="feather-alert-circle"></i>
                                    </span>
                                </div>
                                <div class="fs-11 text-muted mt-1">After deadline</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border border-dashed rounded position-relative">
                                <div class="fs-12 text-muted mb-1">On-Time Percentage</div>
                                <div class="d-flex align-items-center gap-2">
                                    <h3 class="fw-bold mb-0" id="ontimePercentage">0%</h3>
                                    <span id="ontimeStatusBadge" class="badge"></span>
                                </div>
                                <div class="progress mt-2" style="height: 10px;">
                                    <div id="ontimeProgressBar" class="progress-bar" role="progressbar" style="width: 0%">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [Vendor On-Time Submission KPI] end -->

        <div class="col-12">
            <!-- [On-Time Submission Chart & Vendor Performance] start -->
            <div class="row">
                <div class="col-xxl-6">
                    <div class="card stretch stretch-full">
                        <div class="card-header">
                            <h5 class="card-title">On-Time vs Late Distribution</h5>
                            <div class="card-header-action">
                                <div class="card-header-btn">
                                    <div data-bs-toggle="tooltip" title="Refresh">
                                        <a href="javascript:void(0);" class="avatar-text avatar-xs bg-warning"
                                           onclick="loadOnTimeSubmissionKpi()"> </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body custom-card-action">
                            <div id="ontime-submission-chart"></div>
                        </div>
                    </div>
                </div>
                <div class="col-xxl-6">
                    <div class="card stretch stretch-full">
                        <div class="card-header">
                            <h5 class="card-title">Vendor Performance Ranking</h5>
                            <div class="card-header-action">
                                <div class="card-header-btn">
                                    <div data-bs-toggle="tooltip" title="Refresh">
                                        <a href="javascript:void(0);" class="avatar-text avatar-xs bg-warning"
                                           onclick="loadOnTimeSubmissionKpi()"> </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body custom-card-action">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Vendor</th>
                                            <th class="text-center">Total</th>
                                            <th class="text-center">On-Time %</th>
                                            <th class="text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody id="vendorPerformanceTable">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">Loading...</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- [On-Time Submission Chart & Vendor Performance] end -->
        </div>

        <!-- [Budget KPI Summary] start -->
        <div class="col-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Budget Summary <span id="budget-year-display"
                                                                    class="badge bg-primary">2026</span></h5>
                        <div class="card-header-action">
                            <select id="budgetYearFilter" class="form-select form-select-sm" style="width: 120px;">
                                <option value="2024">2024</option>
                                <option value="2025">2025</option>
                                <option value="2026" selected>2026</option>
                                <option value="2027">2027</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="p-3 border border-dashed rounded">
                                    <div class="fs-12 text-muted mb-1">Total Budget</div>
                                    <h5 class="fw-bold text-dark" id="totalBudget">Rp 0</h3>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-3 border border-dashed rounded">
                                        <div class="fs-12 text-muted mb-1">Realisasi</div>
                                        <h5 class="fw-bold text-primary" id="totalRealisasi">Rp 0</h3>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-3 border border-dashed rounded">
                                            <div class="fs-12 text-muted mb-1">Sisa Budget</div>
                                            <h5 class="fw-bold text-success" id="sisaBudget">Rp 0</h3>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="p-3 border border-dashed rounded position-relative">
                                                <div class="fs-12 text-muted mb-1">Serapan Anggaran</div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <h5 class="fw-bold mb-0" id="persentaseSerapan">0%</h5>
                                                    <span id="trafficLight" class="badge"
                                                          style="width: 20px; height: 20px; border-radius: 50%;"></span>
                                                </div>
                                                <div class="progress mt-2" style="height: 10px;">
                                                    <div id="serapanProgressBar" class="progress-bar" role="progressbar" style="width: 0%">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- [Budget KPI Summary] end -->

                        <!-- [Budget vs Realisasi by Vendor & Monthly Realisasi Trend] start -->
                        <div class="row">
                            <div class="col-xxl-6">
                                <div class="card stretch stretch-full">
                                    <div class="card-header">
                                        <h5 class="card-title">Budget vs Realisasi per Vendor</h5>
                                        <div class="card-header-action">
                                            <div class="card-header-btn">
                                                <div data-bs-toggle="tooltip" title="Refresh">
                                                    <a href="javascript:void(0);" class="avatar-text avatar-xs bg-warning"
                                                       onclick="loadBudgetKpiChart()"> </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body custom-card-action">
                                        <div id="budget-kpi-chart"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xxl-6">
                                <div class="card stretch stretch-full">
                                    <div class="card-header">
                                        <h5 class="card-title">Trend Realisasi Bulanan</h5>
                                        <div class="card-header-action">
                                            <div class="card-header-btn">
                                                <div data-bs-toggle="tooltip" title="Refresh">
                                                    <a href="javascript:void(0);" class="avatar-text avatar-xs bg-warning"
                                                       onclick="loadMonthlyRealisasiChart()"> </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body custom-card-action">
                                        <div id="monthly-realisasi-chart"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- [Budget vs Realisasi by Vendor & Monthly Realisasi Trend] end -->

