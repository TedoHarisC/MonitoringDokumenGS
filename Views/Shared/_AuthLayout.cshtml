<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description"
          content="Login ke aplikasi Monitoring Dokumen GS untuk mengelola kontrak, invoice, dan budget perusahaan secara efisien.">
    <meta name="keyword" content="monitoring dokumen, kontrak, invoice, budget, login">
    <meta name="author" content="theme_ocean">
    <!--! The above 6 meta tags *must* come first in the head; any other head content must come *after* these tags !-->
    <!--! BEGIN: Apps Title-->
    <title>Monitoring Dokumen GS || Login Cover</title>
    <!--! END:  Apps Title-->
    <!--! BEGIN: Favicon-->
    <link rel="shortcut icon" type="image/x-icon" href="~/images/logo_small.webp">
        <!--! END: Favicon-->
        <!--! BEGIN: Preconnect to CDN -->
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
        <!--! END: Preconnect to CDN -->
        <!--! BEGIN: Bootstrap CSS-->
        <link rel="stylesheet" type="text/css" href="~/lib/templates/css/bootstrap.min.css">
            <!--! END: Bootstrap CSS-->
            <!--! BEGIN: Vendors CSS-->
            <link rel="stylesheet" type="text/css" href="~/lib/templates/vendors/css/vendors.min.css" media="print"
                  onload="this.media='all'">
                <noscript>
                    <link rel="stylesheet" type="text/css" href="~/lib/templates/vendors/css/vendors.min.css">
                    </noscript>
                    <!--! END: Vendors CSS-->
                    <!--! BEGIN: Custom CSS-->
                    <link rel="stylesheet" type="text/css" href="~/lib/templates/css/theme.min.css">
                        <!--! END: Custom CSS-->
                        <!--! HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries !-->
                        <!--! WARNING: Respond.js doesn"t work if you view the page via file: !-->
                        <!--[if lt IE 9]>
                        <script src="https:oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
                        <script src="https:oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
                        <![endif]-->
                    </head>

                    <body>
                        <!--! ================================================================ !-->
                        <!--! [Start] Main Content !-->
                        <!--! ================================================================ !-->
                        @RenderBody()
                        <!--! ================================================================ !-->
                        <!--! [End] Main Content !-->
                        <!--! ================================================================ !-->
                        <!--! ================================================================ !-->
                        <!--! ================================================================ !-->
                        <!--! Footer Script !-->
                        <!--! ================================================================ !-->
                        <!--! BEGIN: Vendors JS !-->
                        <script src="~/lib/templates/vendors/js/vendors.min.js"></script>
                        <!-- vendors.min.js {always must need to be top} -->
                        <!--! END: Vendors JS !-->
                        <!--! BEGIN: Apps Init  !-->
                        <script src="~/lib/templates/js/common-init.min.js"></script>
                        <!--! END: Apps Init !-->
                        <!--! BEGIN: Theme Customizer  !-->
                        <script src="~/lib/templates/js/theme-customizer-init.min.js"></script>
                        <!--! END: Theme Customizer !-->
                        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                        <!-- Scripts -->
                        @RenderSection("Scripts", required: false)
