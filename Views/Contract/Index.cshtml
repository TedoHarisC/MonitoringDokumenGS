@using System.Security.Claims
@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    string? currentUserId = User?.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    string? userRole = User?.FindFirstValue(ClaimTypes.Role) ?? string.Empty;
    bool isAdmin = userRole == "SUPER_ADMIN" || userRole == "ADMIN";
}

@section Styles {
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" rel="stylesheet" />
    <style>
        div.dataTables_wrapper div.dataTables_filter label,
        div.dataTables_wrapper div.dataTables_length label {
            margin-bottom: 0;
        }

        div.dataTables_wrapper div.dataTables_filter input {
            width: 240px;
        }

        table.dataTable>thead>tr>th {
            white-space: nowrap;
        }

        .dataTables_scrollBody {
            padding-bottom: .5rem;
        }

        td.dt-actions {
            padding-top: .6rem !important;
            padding-bottom: .6rem !important;
            overflow: visible !important;
        }

        .modal {
            z-index: 2000 !important;
        }

        .modal-backdrop {
            z-index: 1990 !important;
        }

        /* Timeline UI for history */
        .timeline {
            border-left: 3px solid #0d6efd22;
            margin-left: 1.5rem;
            padding-left: 1.5rem;
        }

        .timeline-item {
            position: relative;
        }

        .timeline-item:before {
            content: '';
            position: absolute;
            left: -1.7rem;
            top: 0.5rem;
            width: 1rem;
            height: 1rem;
            background: #0d6efd;
            border-radius: 50%;
            border: 2px solid #fff;
            box-shadow: 0 0 0 2px #0d6efd22;
        }
    </style>
}

<input type="hidden" id="currentUserId" value="@currentUserId" />
<input type="hidden" id="currentUserIsAdmin" value="@isAdmin.ToString().ToLower()" />

<!-- [ page-header ] start -->
<div class="page-header">
    <div class="page-header-left d-flex align-items-center">
        <div class="page-header-title">
            <h5 class="m-b-10">Contracts</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)">Transactions</a></li>
            <li class="breadcrumb-item">Contract</li>
        </ul>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex align-items-center gap-2 page-header-right-items-wrapper">
                <button id="btnCreateContract" type="button" class="btn btn-primary">
                    <i class="feather-plus me-2"></i>
                    <span>Create Contract</span>
                </button>
            </div>
        </div>
    </div>
</div>
<!-- [ page-header ] end -->

<!-- [ Main Content ] start -->
<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center flex-wrap gap-2 w-100">
                        <div class="flex-grow-1">
                            <h6 class="mb-0">Contract List</h6>
                            <small class="text-muted">Manage contracts</small>
                        </div>
                        <div id="contractExportActions" class="d-flex align-items-center justify-content-end ms-auto">
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filter Section -->
                    <div class="filter-section border rounded-3 p-3 mb-4 bg-light-subtle">
                        <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                            <i class="feather-filter text-primary fs-5 me-2"></i>
                            <h6 class="mb-0 fw-semibold">Filter Data</h6>
                        </div>
                        <div class="row g-3 align-items-end" id="filterSection">
                            @if (isAdmin)
                            {
                                <div class="col-xl-2 col-md-4 col-sm-6">
                                    <label class="form-label fs-12 text-muted mb-1">Vendor</label>
                                    <select id="filterVendor" class="form-select form-select-sm">
                                        <option value="">All Vendor</option>
                                    </select>
                                </div>
                            }
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <label class="form-label fs-12 text-muted mb-1">Contract Status</label>
                                <select id="filterContractStatus" class="form-select form-select-sm">
                                    <option value="">All Status</option>
                                </select>
                            </div>
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <label class="form-label fs-12 text-muted mb-1">Approval Status</label>
                                <select id="filterApprovalStatus" class="form-select form-select-sm">
                                    <option value="">All Status</option>
                                </select>
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6">
                                <label class="form-label fs-12 text-muted mb-1">Start Date</label>
                                <input type="date" id="filterStartDate" class="form-control form-control-sm" />
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6">
                                <label class="form-label fs-12 text-muted mb-1">End Date</label>
                                <input type="date" id="filterEndDate" class="form-control form-control-sm" />
                            </div>
                            <div class="col-12 mt-3 pt-3 border-top d-flex justify-content-end gap-2">
                                <button id="btnResetFilter" class="btn btn-light-secondary btn-sm">
                                    <i class="feather-refresh-ccw me-1"></i>Reset
                                </button>
                                <button id="btnApplyFilter" class="btn btn-primary btn-sm px-4">
                                    <i class="feather-search me-1"></i>Terapkan Filter
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table id="contractsTable"
                               class="table table-striped table-bordered table-hover align-middle w-100">
                            <thead>
                                <tr>
                                    <th>Contract Number</th>
                                    <th>Vendor</th>
                                    <th>Description</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th class="text-center">Contract Status</th>
                                    @* <th>Contract Status</th> *@
                                    <th>Approval Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->

<!-- Create/Edit Modal -->
<div class="modal fade" id="contractModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="contractForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="contractModalLabel">Create Contract</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="contractId" />
                    <input type="hidden" id="contractStatusId" value="2" />
                    <input type="hidden" id="approvalStatusId" value="6" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Vendor</label>
                            <!-- Untuk Admin -->
                            <select id="vendorIdSelect" class="form-control" style="display:none;"></select>
                            <!-- Untuk User -->
                            <input type="hidden" id="vendorId" />
                            <input id="vendorName" class="form-control" disabled />
                        </div>
                        <div class="col-12 col-md-6" id="contractStatusSection" style="display: none;">
                            <label class="form-label">Contract Status</label>
                            <select id="contractStatusSelect" class="form-control">
                                <option value="">-- Select Contract Status --</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6" id="approvalStatusSection" style="display: none;">
                            <label class="form-label">Approval Status</label>
                            <select id="approvalStatusSelect" class="form-control">
                                <option value="">-- Select Approval Status --</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-12">
                            <label class="form-label">Contract Number</label>
                            <input id="contractNumber" class="form-control" autocomplete="off" required />
                        </div>
                        <div class="col-12 col-md-12">
                            <label class="form-label">Contract Description</label>
                            <textarea id="contractDescription" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Start Date</label>
                            <input id="startDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">End Date</label>
                            <input id="endDate" type="date" class="form-control" required />
                        </div>
                    </div>

                    <!-- Attachments Section (only for Edit mode) -->
                    <div id="attachmentsSection" style="display: none;" class="mt-4">
                        <hr />
                        <h6 class="mb-3">Attachments</h6>
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-5">
                                <label class="form-label">Attachment Type</label>
                                <select id="attachmentTypeSelect" class="form-control">
                                    <option value="">-- Pilih Tipe Attachment --</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Upload File</label>
                                <input type="file" id="fileUploadInput" class="form-control"
                                       accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-info w-100" id="btnAddFile">
                                    <i class="feather-plus me-1"></i> Add File
                                </button>
                            </div>
                            <div class="col-md-12">
                                <small class="text-muted">Max 10MB. Allowed: PDF, Images, Word, Excel</small>
                            </div>
                        </div>
                        <div id="attachmentsList" class="list-group"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Detail Contract -->
<div class="modal fade" id="contractDetailModal" tabindex="-1" aria-labelledby="contractDetailModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="contractDetailModalLabel">Detail Contract</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="contractDetailContent">
                    <!-- Dynamic content loaded by JS -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="/js/transaction-contract.js?v=@DateTime.Now.Ticks"></script>
}